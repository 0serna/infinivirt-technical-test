{
  "name": "support-ticketing",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "compose:up": "docker compose up --build",
    "compose:down": "docker compose down",
