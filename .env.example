# Postgres role Compose creates
POSTGRES_USER=support
POSTGRES_PASSWORD=support
POSTGRES_DB=support_ticketing

# Host publish of container 5432. DATABASE_URL inside Compose stays @postgres:5432
POSTGRES_PORT=5432

# API container URL. Host postgres, port 5432. From the host, override to localhost and POSTGRES_PORT
DATABASE_URL=postgresql://support:support@postgres:5432/support_ticketing

# Signs access tokens
JWT_SECRET=change-me-in-local-dev

# Access token lifetime (jsonwebtoken duration)
JWT_EXPIRES_IN=8h

# API container runs prisma db seed after migrate (idempotent). Set 0 to skip.
SEED_ON_START=1
