POSTGRES_USER=support
POSTGRES_PASSWORD=support
POSTGRES_DB=support_ticketing
# Host port mapped to container 5432. Change if host 5432 is taken (e.g. 15432).
POSTGRES_PORT=5432
# Compose service hostname. Host CLI migrate/seed: localhost + this port instead:
# DATABASE_URL=postgresql://support:support@localhost:5432/support_ticketing
DATABASE_URL=postgresql://support:support@postgres:5432/support_ticketing
# Signing secret for Bearer access JWTs (required by the API). Change for any shared environment.
JWT_SECRET=change-me-in-local-dev
# Access token lifetime ( Nest/jsonwebtoken duration string, ~one support shift ).
JWT_EXPIRES_IN=8h
